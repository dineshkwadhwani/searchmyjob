# Frontend environment variables (copy to .env.local and fill in values)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Edge Function secrets (set via: supabase secrets set KEY=value --use-api)
# or place in supabase/.env for local dev
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@searchmyjob.online
RESEND_FROM_NAME=SearchMyJob AI
SITE_URL=https://searchmyjob.online
